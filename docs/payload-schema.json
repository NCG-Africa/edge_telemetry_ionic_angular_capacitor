{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NCG-Africa/edge_telemetry_ionic_angular_capacitor/docs/payload-schema.json",
  "title": "edge-rum 5.0 request body (wire contract 4.0.0)",
  "description": "Body of each POST the native plugin sends: gzip-compressed JSON, headers Content-Type: application/json, Content-Encoding: gzip, X-API-Key. Event names and keys: docs/events.md.",
  "type": "object",
  "required": ["type", "contract_version", "timestamp", "batch_size", "device_id", "sdk", "app", "events"],
  "additionalProperties": false,
  "properties": {
    "type": { "const": "telemetry_batch" },
    "contract_version": { "const": "4.0.0" },
    "timestamp": { "type": "string", "format": "date-time", "description": "Send time, UTC with milliseconds; new on every attempt." },
    "batch_size": { "type": "integer", "minimum": 1, "description": "Length of events." },
    "device_id": {
      "type": "string",
      "pattern": "^(device_[0-9]+_[0-9a-f]{16}_(android|ios)|[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[0-9a-f]{4}-[0-9a-f]{12})$",
      "description": "device_<epochMs>_<16 hex>_<platform>; Android falls back to a UUID v4 if storage fails."
    },
    "sdk": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": { "const": "ionic" },
        "version": { "type": "string", "description": "npm package version." }
      }
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "description": "Read from the app binary. Unknown values are omitted.",
      "properties": {
        "name": { "type": "string" },
        "package_name": { "type": "string" },
        "platform": { "enum": ["android", "ios"] },
        "version": { "type": "string" },
        "build_number": { "type": "string" }
      }
    },
    "events": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/item" } }
  },
  "$defs": {
    "attributes": {
      "type": "object",
      "description": "Flat: dotted keys, primitive values only.",
      "additionalProperties": { "type": ["string", "number", "boolean"] },
      "properties": {
        "session.id": { "type": "string", "pattern": "^session_", "description": "session_<epochMs>_<16 hex>_<platform>" },
        "trace.id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "span.id": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "parent.span.id": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "rum.action.id": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "trace.root_type": { "enum": ["launch", "interaction", "navigation", "request", "resume"] },
        "traceparent.outcome": {
          "enum": ["injected_attributed", "injected_unattributed", "injected_expired", "adopted", "skipped_off_allowlist", "skipped_no_cors", "skipped_no_session"]
        }
      }
    },
    "item": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "eventName", "timestamp", "attributes"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "event" },
            "eventName": {
              "enum": [
                "session.started", "session.finalized", "app_lifecycle", "app.start", "network_change",
                "memory_pressure", "user.profile.update", "sdk.health",
                "app.crash", "app.anr", "app.hang", "app.exit",
                "navigation", "screen.duration", "http.request", "ui.interaction",
                "frame.summary", "bridge.summary", "custom_event", "task.complete"
              ]
            },
            "timestamp": { "type": "string", "format": "date-time" },
            "attributes": { "$ref": "#/$defs/attributes" }
          }
        },
        {
          "type": "object",
          "required": ["type", "metricName", "value", "timestamp", "attributes"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "metric" },
            "metricName": {
              "type": "string",
              "description": "LCP, INP, CLS, FCP, TTFB, long_task, resource_timing, memory_usage, or a name passed to measure() / time()."
            },
            "value": { "type": "number" },
            "timestamp": { "type": "string", "format": "date-time" },
            "attributes": { "$ref": "#/$defs/attributes" }
          }
        }
      ]
    }
  }
}
